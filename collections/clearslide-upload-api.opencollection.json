{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClearSlide Platform Insights Upload API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://oauth.platform.clearslide.com/oauth/authorize",
      "accessTokenUrl": "https://oauth.platform.clearslide.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get upload credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.clearslide.com/upload",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://oauth.platform.clearslide.com/oauth/authorize",
              "accessTokenUrl": "https://oauth.platform.clearslide.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get credentials to upload your file to ClearSlide (Amazon S3)."
        },
        {
          "info": {
            "name": "Check upload status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.clearslide.com/upload/:uploadID",
            "params": [
              {
                "name": "uploadID",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://oauth.platform.clearslide.com/oauth/authorize",
              "accessTokenUrl": "https://oauth.platform.clearslide.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Check the status of an uploaded file."
        }
      ]
    }
  ],
  "bundled": true
}