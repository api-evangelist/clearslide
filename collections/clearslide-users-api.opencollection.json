{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClearSlide Platform Insights Users API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://oauth.platform.clearslide.com/oauth/authorize",
      "accessTokenUrl": "https://oauth.platform.clearslide.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.clearslide.com/users",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://oauth.platform.clearslide.com/oauth/authorize",
              "accessTokenUrl": "https://oauth.platform.clearslide.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a list of `user` objects that match query criteria."
        }
      ]
    }
  ],
  "bundled": true
}